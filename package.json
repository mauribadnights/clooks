{
  "name": "@mauribadnights/clooks",
  "version": "0.5.2",
  "description": "Persistent hook runtime for Claude Code — eliminates process spawning overhead and gives you observability",
  "bin": {
    "clooks": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npx tsx benchmarks/bench.ts"
  },
  "license": "MIT",
  "author": "mauribadnights",
  "repository": {
    "type": "git",
    "url": "https://github.com/mauribadnights/clooks.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "hooks",
    "daemon",
    "cli"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "docs",
    "hooks",
    "agents",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "commander": "^14.0.3",
    "yaml": "^2.8.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
}
